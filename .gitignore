bin/
obj/
# build output - release binaries are published as GitHub Release assets, not committed
publish/
node_modules/
*.user
.vs/
.vscode/*
!.vscode/extensions.json

# build output of the web console (served by the server)
src/SentinelDesk.Server/wwwroot/

# runtime data: SQLite DB and server key material — never commit
data/
# ...but not the server's source folder Data/ (Windows paths are case-insensitive, so data/ also matched it)
!src/SentinelDesk.Server/Data/
**/data/keys/
*.db
*.db-shm
*.db-wal

# local dev runtime (dev.ps1)
.run/

# local notes / secrets
.env
*.env
