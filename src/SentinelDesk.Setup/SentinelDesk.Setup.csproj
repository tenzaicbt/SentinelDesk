<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FluentSetup: the SentinelDesk agent installer, upgrader and uninstaller (Windows 11 Fluent-style wizard).
    .NET Framework 4.8 is built into every Windows 10 (1903+) and 11, so the setup file needs no runtime and is about the
    size of the agent package it carries.
    build.ps1 builds it twice: without a package (copied into the agent bundle as Uninstall.exe), then with the agent
    package embedded (-p:AgentZip=...) as SentinelDesk-Setup.exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SentinelDesk-Setup</AssemblyName>
    <RootNamespace>SentinelDesk.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\SentinelDesk.ico</ApplicationIcon>
    <Product>SentinelDesk Agent Setup</Product>
    <AssemblyTitle>SentinelDesk Agent Setup</AssemblyTitle>
    <!-- 64-bit process on 64-bit Windows: real Program Files and System32 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- path to the agent bundle zip, passed by build.ps1 -->
    <AgentZip Condition="'$(AgentZip)' == ''"></AgentZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.ServiceProcess" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgentZip)' != ''">
    <EmbeddedResource Include="$(AgentZip)" LogicalName="agent.zip" />
  </ItemGroup>
</Project>
