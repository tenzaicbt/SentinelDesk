<label class="@Cls.Join("block", Class)">
    <span class="mb-1.5 block text-[13px] font-medium leading-none text-fg">@Label</span>
    @ChildContent
    @if (HintContent is not null || Hint is not null)
    {
        <span class="mt-1 block text-xs text-muted">@if (HintContent is not null) { @HintContent } else { @Hint }</span>
    }
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment? HintContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
