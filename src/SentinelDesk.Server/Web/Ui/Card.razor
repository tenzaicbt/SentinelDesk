<section class="@Cls.Join("rounded-lg border border-line bg-panel text-fg shadow-card animate-rise min-w-0", Class)">
    @if (HasHeader)
    {
        <header class="flex items-start justify-between gap-3 px-4 pt-3">
            <div class="min-w-0">
                @if (Title is not null || TitleContent is not null)
                {
                    <h2 class="text-sm leading-none font-semibold text-fg">@if (TitleContent is not null) { @TitleContent } else { @Title }</h2>
                }
                @if (Subtitle is not null || SubtitleContent is not null)
                {
                    <p class="mt-1 text-xs text-muted">@if (SubtitleContent is not null) { @SubtitleContent } else { @Subtitle }</p>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="flex shrink-0 items-center gap-2">@Actions</div>
            }
        </header>
    }
    <div class="@Cls.Join(Cls.If(Pad, "px-4 py-3"), Cls.If(Pad && HasHeader, "pt-2.5"), Cls.If(!Pad && HasHeader, "mt-2.5"))">@ChildContent</div>
</section>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? SubtitleContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Pad { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool HasHeader => Title is not null || TitleContent is not null || Actions is not null;
}
