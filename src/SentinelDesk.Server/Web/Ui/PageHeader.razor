<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
        @if (Icon is not null)
        {
            <div class="grid size-10 place-items-center rounded-lg border border-line bg-panel-2 text-fg [&_svg]:size-5"><Icon Name="@Icon" Class="size-5" /></div>
        }
        <div class="min-w-0">
            <h1 class="text-2xl font-semibold tracking-tight">@Title</h1>
            @if (SubtitleContent is not null)
            {
                <p class="mt-0.5 text-sm text-muted">@SubtitleContent</p>
            }
            else if (Subtitle is not null)
            {
                <p class="mt-0.5 text-sm text-muted">@Subtitle</p>
            }
        </div>
    </div>
    @if (Actions is not null)
    {
        <div class="flex flex-wrap items-center gap-2">@Actions</div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? SubtitleContent { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
