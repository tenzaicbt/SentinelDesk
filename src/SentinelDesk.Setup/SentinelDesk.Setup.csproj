<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny .NET Framework 4.8 wrapper (built into every Windows 10/11), so the setup file is ~ the size of the agent package. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SentinelDesk-Setup</AssemblyName>
    <RootNamespace>SentinelDesk.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>setup.ico</ApplicationIcon>
    <Product>SentinelDesk Agent Setup</Product>
    <Company>SentinelDesk</Company>
    <!-- path to the agent bundle zip, passed by build.ps1 -->
    <AgentZip Condition="'$(AgentZip)' == ''"></AgentZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.ServiceProcess" />
    <EmbeddedResource Include="setup.ico" LogicalName="setup.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgentZip)' != ''">
    <EmbeddedResource Include="$(AgentZip)" LogicalName="agent.zip" />
  </ItemGroup>
</Project>
