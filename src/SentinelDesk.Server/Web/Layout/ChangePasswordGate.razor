<div class="grid min-h-full place-items-center p-4">
    <div class="w-full max-w-sm animate-rise">
        <Brand />
        <h2 class="mt-8 text-xl font-semibold">Set a new password</h2>
        <p class="mb-4 mt-1 text-sm text-muted">Your password was issued by an administrator and must be changed before continuing.</p>
        <PasswordForm OnDone="Session.RefreshAsync" />
        <button type="button" @onclick="Session.LogoutAsync" class="mt-4 text-xs text-muted hover:text-fg">Sign out</button>
    </div>
</div>
