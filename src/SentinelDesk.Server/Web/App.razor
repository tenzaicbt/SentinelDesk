@* The console's HTML document. Everything inside #root runs as interactive server components (Blazor Server). *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <title>SentinelDesk Console</title>
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" href="/brand/icon.png?v=2" />
    <link rel="apple-touch-icon" href="/brand/icon.png?v=2" />
    <link rel="stylesheet" href="/css/tailwind.css" />
    <link rel="stylesheet" href="/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="/css/console.css" />
    <script src="/js/theme.js"></script>
</head>
<body>
    <div id="root">
        <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" ClientIp="@ClientIp" />
    </div>
    <script src="/lib/leaflet/leaflet.js"></script>
    <script src="/js/console.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? ClientIp => HttpContext?.Connection.RemoteIpAddress?.ToString();
}
