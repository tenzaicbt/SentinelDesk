<Modal Open="Open" OnClose="OnClose" Title="Move device">
    <ChildContent>
        <div class="space-y-3">
            <Field Label="Branch / department">
                <Dropdown @bind-Value="_unit" Class="w-full" Options="@UnitOptions" />
            </Field>
            <Field Label="Tags" Hint="Comma separated, e.g. laptop, finance"><input class="@Cls.Input" @bind="_tags" @bind:event="oninput" /></Field>
        </div>
    </ChildContent>
    <Footer>
        <Btn OnClick="OnClose">Cancel</Btn>
        <Btn Variant="primary" OnClick="Save">Save</Btn>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter, EditorRequired] public DeviceDetail D { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private List<OrgUnitRow>? _org;
    private string _unit = "", _tags = "";
    private bool _wasOpen;

    private IEnumerable<Opt> UnitOptions =>
        [new("", "Unassigned"), .. (_org ?? []).OrderBy(o => o.Name, StringComparer.CurrentCulture).Select(o => new Opt(o.Id.ToString(), $"{o.Name} ({o.Type})"))];

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !_wasOpen)
        {
            _unit = D.OrgUnitId?.ToString() ?? "";
            _tags = D.Tags ?? "";
            try { _org ??= await Api.GetAsync<List<OrgUnitRow>>("/api/org"); } catch (ApiException) { }
        }
        _wasOpen = Open;
    }

    private async Task Save()
    {
        try
        {
            await Api.PutAsync($"/api/devices/{D.Id}", new { orgUnitId = _unit == "" ? (Guid?)null : Guid.Parse(_unit), tags = _tags });
            Toast.Success("Device updated — policy will be re-evaluated");
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (ApiException e) { Toast.Fail(e, "Request failed"); }
    }
}
