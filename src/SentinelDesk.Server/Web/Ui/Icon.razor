@* Lucide icon as inline SVG. *@
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" class="@Cls.Join("lucide", Class)" aria-hidden="true">@Paths</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; } = "size-4";

    private MarkupString Paths => new(IconData.Paths.TryGetValue(Name, out var p) ? p : "");
}
