<form @onsubmit="Submit" @onsubmit:preventDefault class="space-y-3">
    @if (_error is not null)
    {
        <Callout Tone="critical">@_error</Callout>
    }
    <Field Label="Current password"><input class="@Cls.Input" type="password" @bind="_current" @bind:event="oninput" required autocomplete="current-password" /></Field>
    <Field Label="New password" Hint="At least 10 characters with upper, lower case and a digit">
        <input class="@Cls.Input" type="password" @bind="_next" @bind:event="oninput" required autocomplete="new-password" />
    </Field>
    <Field Label="Confirm new password"><input class="@Cls.Input" type="password" @bind="_confirm" @bind:event="oninput" required autocomplete="new-password" /></Field>
    <Btn Type="submit" Variant="primary" Loading="_busy" Icon="KeyRound">Update password</Btn>
</form>

@code {
    [Parameter] public EventCallback OnDone { get; set; }

    private string _current = "", _next = "", _confirm = "";
    private string? _error;
    private bool _busy;

    private async Task Submit()
    {
        if (_next != _confirm) { _error = "Passwords do not match"; return; }
        _busy = true; _error = null;
        try
        {
            await Api.PostAsync("/api/auth/change-password", new { current = _current, next = _next });
            Toast.Success("Password updated");
            _current = _next = _confirm = "";
            await OnDone.InvokeAsync();
        }
        catch (ApiException e) { _error = e.Message; }
        finally { _busy = false; }
    }
}
